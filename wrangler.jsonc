// ExecWard's core Worker (task 1.1.1).
//
// Every key in this file is checked against an allowlist in
// src/worker/config-check.ts. A key that is not listed there fails the tests,
// and so fails CI: that is how a new binding, variable or environment is
// stopped from arriving unnoticed (FR-24). To add one, change this file and
// the allowlist in the same pull request, and say why.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "execward",
	"main": "src/worker.ts",
	// Pinned (FR-23). Must equal COMPATIBILITY_DATE in src/worker/bindings.ts.
	"compatibility_date": "2026-11-13",
	"compatibility_flags": [],
	// No workers.dev address. The Worker is reached at one address only, below.
	"workers_dev": false,
	"preview_urls": false,
	"send_metrics": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	// The Worker Loader that runs a script in a Dynamic Worker.
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	// The Worker's own database. Migrations: npx wrangler d1 migrations apply execward --remote
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "execward",
			"database_id": "33b54ace-0649-4949-abe5-dacd833dfe10",
			"migrations_dir": "migrations"
		}
	],
	// Where the daily backup of that database is written (task 1.4.5).
	"r2_buckets": [
		{
			"binding": "BACKUPS",
			"bucket_name": "execward-backups"
		}
	],
	// Sends the link-only emails (task 1.6.7). It may send from this one address only.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["alerts@notify.execward.com"]
		}
	],
	// The owner console's address. Cloudflare Access guards the whole hostname, and the
	// Worker refuses any console request Access did not authenticate (src/console/access.ts).
	"routes": [
		{
			"pattern": "console.execward.com",
			"custom_domain": true
		}
	],
	// The housekeeping timer: every five minutes (src/worker/scheduled.ts).
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}
