{
  "name": "execward",
  "version": "0.0.0",
  "private": true,
  "description": "An LLM-agnostic Code Mode: model-written scripts run in a sandbox behind a policy broker.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "adversarial": "tsx scripts/adversarial.ts",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type application > sbom.cdx.json",
    "check:supply-chain": "tsx scripts/check-supply-chain.ts",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:test-worker": "wrangler deploy -c test/workers/wrangler.deployed.jsonc",
    "test:deployed": "vitest run --config vitest.deployed.config.ts",
    "measure:latency": "tsx scripts/measure-latency.ts",
    "check:deployed": "tsx scripts/check-deployed.ts",
    "audit:export": "tsx scripts/export-audit.ts",
    "emergency:stop": "tsx scripts/emergency-stop.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "openai": "7.62.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "eslint-scope": "9.1.2",
    "zod": "4.6.7"
  }
}
